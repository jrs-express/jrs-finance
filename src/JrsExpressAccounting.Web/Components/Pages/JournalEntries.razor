@page "/journal-entries"
@attribute [Authorize(Policy="AccountingOnly")]
@inject AccountingDbContext Db

<h1>Journal Entries</h1>
<div class="card mb-3"><div class="card-body">
    <EditForm FormName="journalEntriesForm" Model="model" OnValidSubmit="Save">
        <div class="row g-2">
            <div class="col"><InputDate class="form-control" @bind-Value="model.EntryDate" /></div>
            <div class="col"><InputText class="form-control" @bind-Value="model.Particulars" placeholder="Particulars" /></div>
            <div class="col"><InputSelect class="form-select" @bind-Value="model.BranchId">@foreach(var b in branches){<option value="@b.Id">@b.Name</option>}</InputSelect></div>
            <div class="col"><InputSelect class="form-select" @bind-Value="line.ChartOfAccountId">@foreach(var c in coas){<option value="@c.Id">@c.Code - @c.Name</option>}</InputSelect></div>
            <div class="col"><InputNumber class="form-control" @bind-Value="line.Debit" placeholder="Debit" /></div>
            <div class="col"><InputNumber class="form-control" @bind-Value="line.Credit" placeholder="Credit" /></div>
            <div class="col"><InputNumber class="form-control" @bind-Value="line.VatAmount" placeholder="RVAT" /></div>
            <div class="col"><InputNumber class="form-control" @bind-Value="line.WithholdingTaxAmount" placeholder="WTAX" /></div>
            <div class="col-auto"><button class="btn btn-success">Post</button></div>
        </div>
    </EditForm>
</div></div>
<table class="table table-sm"><thead><tr><th>No</th><th>Date</th><th>Branch</th><th>Particulars</th></tr></thead><tbody>@foreach(var j in entries){<tr><td>@j.EntryNo</td><td>@j.EntryDate.ToShortDateString()</td><td>@j.Branch.Name</td><td>@j.Particulars</td></tr>}</tbody></table>

@code {
    private List<JournalEntry> entries = new();
    private List<Branch> branches = new();
    private List<ChartOfAccount> coas = new();
    private JournalEntry model = new() { EntryDate = DateTime.Today };
    private JournalEntryLine line = new();

    protected override async Task OnInitializedAsync()
    {
        branches = await Db.Branches.ToListAsync();
        coas = await Db.ChartOfAccounts.ToListAsync();
        model.BranchId = branches.FirstOrDefault()?.Id ?? 0;
        line.ChartOfAccountId = coas.FirstOrDefault()?.Id ?? 0;
        await Load();
    }

    private async Task Load() => entries = await Db.JournalEntries.Include(x => x.Branch).OrderByDescending(x => x.EntryDate).Take(100).ToListAsync();

    private async Task Save()
    {
        model.EntryNo = $"JE-{DateTime.UtcNow:yyyyMMddHHmmss}";
        model.Lines.Add(line);
        Db.JournalEntries.Add(model);
        await Db.SaveChangesAsync();
        model = new JournalEntry { EntryDate = DateTime.Today, BranchId = branches.FirstOrDefault()?.Id ?? 0 };
        line = new JournalEntryLine { ChartOfAccountId = coas.FirstOrDefault()?.Id ?? 0 };
        await Load();
    }
}
