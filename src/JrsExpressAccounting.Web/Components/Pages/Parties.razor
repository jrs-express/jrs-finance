@page "/parties"
@attribute [Authorize(Policy="AccountingOnly")]
@inject AccountingDbContext Db

<h1>Customers and Vendors (BIR Info)</h1>
<div class="card mb-3"><div class="card-body"><EditForm Model="model" OnValidSubmit="Save"><div class="row g-2">
<div class="col-2">
    <select class="form-select" @bind="model.PartyType">
        <option value="0">Customer</option>
        <option value="1">Vendor</option>
    </select>
</div>
<div class="col"><input class="form-control" @bind="model.Name" placeholder="Name" /></div>
<div class="col"><input class="form-control" @bind="model.Tin" placeholder="TIN" /></div>
<div class="col"><input class="form-control" @bind="model.BusinessStyle" placeholder="Business Style" /></div>
<div class="col"><input class="form-control" @bind="model.TaxType" placeholder="Tax Type (VAT/RVAT/WTAX)" /></div>
<div class="col-auto"><button class="btn btn-success">Add</button></div>
</div></EditForm></div></div>
<table class="table table-sm"><thead><tr><th @onclick="ToggleSort">Name</th><th>Type</th><th>TIN</th><th>Tax</th></tr></thead><tbody>@foreach(var p in items){<tr><td>@p.Name</td><td>@p.PartyType</td><td>@p.Tin</td><td>@p.TaxType</td></tr>}</tbody></table>

@code {
    private List<Party> items = new();
    private Party model = new(){TaxType="RVAT"};
    private bool asc = true;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load(){ var q = Db.Parties.AsNoTracking(); items = asc ? await q.OrderBy(x=>x.Name).Take(200).ToListAsync() : await q.OrderByDescending(x=>x.Name).Take(200).ToListAsync();}
    private async Task Save(){ Db.Parties.Add(model); await Db.SaveChangesAsync(); model = new(){TaxType="RVAT"}; await Load(); }
    private async Task ToggleSort(){ asc = !asc; await Load(); }
}
