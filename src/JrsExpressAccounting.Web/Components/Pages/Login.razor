@page "/login"
@layout Layout.EmptyLayout
@inject AuthService AuthService
@inject NavigationManager Nav

<div class="container mt-5" style="max-width:420px;">
    <div class="card shadow">
        <div class="card-header bg-success text-white">JRS Express Accounting Login</div>
        <div class="card-body">
            <div class="mb-3">
                <label>Username</label>
                <InputText class="form-control" @bind-Value="model.Username" />
            </div>
            <div class="mb-3">
                <label>Password</label>
                <InputText class="form-control" type="password" @bind-Value="model.Password" />
            </div>
            <button class="btn btn-success w-100" type="button" @onclick="OnLogin">Login</button>
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="text-danger mt-2">@error</div>
            }
            <small class="text-muted d-block mt-3">Seed user: admin / Admin@123</small>
        </div>
    </div>
</div>

@code {
    private LoginModel model = new();
    private string? error;

    private async Task OnLogin()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(model.Username) || string.IsNullOrWhiteSpace(model.Password))
        {
            error = "Username and password are required.";
            return;
        }

        var ok = await AuthService.LoginAsync(model.Username, model.Password);
        if (!ok)
        {
            error = "Invalid credentials.";
            return;
        }

        Nav.NavigateTo("/", forceLoad: true);
    }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
