@using Microsoft.AspNetCore.Components.Authorization
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="context">
            <AuthorizeRouteView RouteData="@context" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <p class="m-4">You are not authorized. Please <a href="/login">login</a>.</p>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@context" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
